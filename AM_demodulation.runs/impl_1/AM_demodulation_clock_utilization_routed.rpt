# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y1 [get_cells u_PLL_ADC_DAC/inst/clkout2_buf]
set_property LOC BUFGCTRL_X0Y3 [get_cells u_PLL_ADC_DAC/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y0 [get_cells u_PLL_ADC_DAC/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y2 [get_cells clk_50M_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y128 [get_cells dac_clk_OBUF_inst]
set_property LOC IOB_X1Y190 [get_cells adc_clk_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X0Y126 [get_ports clk_50M]

# Clock net "clk_50M_IBUF_BUFG" driven by instance "clk_50M_IBUF_BUFG_inst" located at site "BUFGCTRL_X0Y2"
#startgroup
create_pblock {CLKAG_clk_50M_IBUF_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_clk_50M_IBUF_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=u_PLL_ADC_DAC/inst/mmcm_adv_inst} -of_object [get_pins -leaf -filter {DIRECTION==IN} -of_objects [get_nets {clk_50M_IBUF_BUFG}]]]
resize_pblock [get_pblocks {CLKAG_clk_50M_IBUF_BUFG}] -add {CLOCKREGION_X0Y2:CLOCKREGION_X0Y2}
#endgroup
